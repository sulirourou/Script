name: 京东比价
description: 首次使用需安装慢慢买应用，之后点击进入[我的]页面以捕获Cookie，捕获成功后方可在商品详情页面查看比价内容。
author: wf021325, githubdulong, mw418
category: Shopping

scripts:
  - name: 捕获令牌
    type: request
    match: ^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$
    url: https://kelee.one/Resource/JavaScript/JD/JD_Price.js
    requires_body: true
    timeout: 10

  - name: 京东比价
    type: response
    match: ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html
    url: https://kelee.one/Resource/JavaScript/JD/JD_Price.js
    requires_body: true
    timeout: 10

mitm:
  - in.m.jd.com
  - apapia-sqk-weblogic.manmanbuy.com
