#!name=网络测速网站
#!desc=网络测速网站统一分流。请在模块参数内设置你想要使用的策略组（默认走 CheckPolicy）。
#!author=Gemini
#!category=Rules
#!arguments=Proxy:CheckPolicy
#!arguments-desc=Proxy: 请输入你想使用的策略组名称

[Rule]
# > Ookla Speedtest
DOMAIN-SUFFIX,speedtest.net,{{Policy}}

# > Fast.com
DOMAIN-SUFFIX,fast.com,{{Policy}}

# > Google Fiber Speedtest
DOMAIN-SUFFIX,fiber.google.com,{{Policy}}

# > Cloudflare Speed
DOMAIN-SUFFIX,speed.cloudflare.com,{{Policy}}

# > OpenSpeedTest
DOMAIN-SUFFIX,openspeedtest.com,{{Policy}}
