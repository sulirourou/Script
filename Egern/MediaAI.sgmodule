#!name=域名分流
#!desc=支持自定义节点检测。在参数内为不同模块和网站选择独立策略组。
#!category=网络检测
#!arguments=Proxy:Final, Apasidao:Final, GCP:Final, IPAPI:Final, Browserleaks:Final, GitBlur:Final, GreasyFork:Final
#!arguments-desc=Proxy: 流媒体及AI默认策略, Apasidao: 爱啪思道策略, GCP: GCP策略, IPAPI: IP-API策略, Browserleaks: Browserleaks策略, GitBlur: GitBlur策略, GreasyFork: Greasy Fork策略

[Rule]
# --- [IP 信息检测] ---
# 用于面板获取 IP 地理位置及纯净度数据
DOMAIN-SUFFIX,ippure.com,{{{Proxy}}}

# --- [流媒体服务] ---
# Dazn
DOMAIN-SUFFIX,dazn.com,{{{Proxy}}}

# TikTok
DOMAIN-SUFFIX,tiktok.com,{{{Proxy}}}
DOMAIN-SUFFIX,byteoversea.com,{{{Proxy}}}

# Netflix
DOMAIN-SUFFIX,netflix.com,{{{Proxy}}}
DOMAIN-SUFFIX,nflxso.net,{{{Proxy}}}

# Disney+
DOMAIN-SUFFIX,disneyplus.com,{{{Proxy}}}
DOMAIN-SUFFIX,disney.com,{{{Proxy}}}

# YouTube
DOMAIN-SUFFIX,googleusercontent.com,{{{Proxy}}}
DOMAIN-SUFFIX,googlevideo.com,{{{Proxy}}}

# HBO Max / Max
DOMAIN-SUFFIX,max.com,{{{Proxy}}}
DOMAIN-SUFFIX,hbomax.com,{{{Proxy}}}

# Discovery+
DOMAIN-SUFFIX,discoveryplus.com,{{{Proxy}}}

# Paramount+
DOMAIN-SUFFIX,paramountplus.com,{{{Proxy}}}

# --- [AI 助手] ---
# Grok (x.ai)
DOMAIN-SUFFIX,x.ai,{{{Proxy}}}

# Claude
DOMAIN-SUFFIX,claude.ai,{{{Proxy}}}
DOMAIN-SUFFIX,anthropic.com,{{{Proxy}}}

# Gemini
DOMAIN-SUFFIX,gemini.google.com,{{{Proxy}}}
DOMAIN-SUFFIX,google.com,{{{Proxy}}}

# ChatGPT
DOMAIN-SUFFIX,chatgpt.com,{{{Proxy}}}
DOMAIN-SUFFIX,openai.com,{{{Proxy}}}
DOMAIN-SUFFIX,oaistatic.com,{{{Proxy}}}
DOMAIN-SUFFIX,oaiusercontent.com,{{{Proxy}}}

# ==================================
# --- [独立自定义策略组网站] ---
# ==================================

# 爱啪思道 (精确匹配)
DOMAIN,app.localhost.qaq.wiki,{{{Apasidao}}}

# GCP (IP 匹配)
IP-CIDR,35.212.188.11/32,{{{GCP}}},no-resolve

# IP-API (通配后缀匹配)
DOMAIN-SUFFIX,ip-api.com,{{{IPAPI}}}

# Browserleaks (后缀匹配)
DOMAIN-SUFFIX,browserleaks.com,{{{Browserleaks}}}

# GitBlur (后缀匹配)
DOMAIN-SUFFIX,gitblur.com,{{{GitBlur}}}

# Greasy Fork (后缀匹配)
DOMAIN-SUFFIX,greasyfork.org,{{{GreasyFork}}}
