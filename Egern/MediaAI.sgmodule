#!name=IP-Pure & 流媒体 & AI 检测
#!desc=支持自定义节点检测。在参数内为不同模块和网站选择独立策略组。
#!category=网络检测
#!arguments=Proxy:DIRECT, Policy_Apasidao:DIRECT, Policy_GCP:Google, Policy_IPAPI:Claw Cloud S, Policy_Browserleaks:Claw Cloud S, Policy_GitBlur:GitHub, Policy_GreasyFork:Final
#!arguments-desc=Proxy: 流媒体及AI默认策略, Policy_Apasidao: 爱啪思道策略, Policy_GCP: GCP策略, Policy_IPAPI: IP-API策略, Policy_Browserleaks: Browserleaks策略, Policy_GitBlur: GitBlur策略, Policy_GreasyFork: Greasy Fork策略

[Rule]
# --- [IP 信息检测] ---
# 用于面板获取 IP 地理位置及纯净度数据
DOMAIN-SUFFIX,ippure.com,{{{Proxy}}}

# --- [流媒体服务] ---
# Dazn
DOMAIN-SUFFIX,dazn.com,{{{Proxy}}}

# TikTok
DOMAIN-SUFFIX,tiktok.com,{{{Proxy}}}
DOMAIN-SUFFIX,byteoversea.com,{{{Proxy}}}

# Netflix
DOMAIN-SUFFIX,netflix.com,{{{Proxy}}}
DOMAIN-SUFFIX,nflxso.net,{{{Proxy}}}

# Disney+
DOMAIN-SUFFIX,disneyplus.com,{{{Proxy}}}
DOMAIN-SUFFIX,disney.com,{{{Proxy}}}

# YouTube
DOMAIN-SUFFIX,youtube.com,{{{Proxy}}}
DOMAIN-SUFFIX,googlevideo.com,{{{Proxy}}}

# HBO Max / Max
DOMAIN-SUFFIX,max.com,{{{Proxy}}}
DOMAIN-SUFFIX,hbomax.com,{{{Proxy}}}

# Discovery+
DOMAIN-SUFFIX,discoveryplus.com,{{{Proxy}}}

# Paramount+
DOMAIN-SUFFIX,paramountplus.com,{{{Proxy}}}

# --- [AI 助手] ---
# Grok (x.ai)
DOMAIN-SUFFIX,x.ai,{{{Proxy}}}

# Claude
DOMAIN-SUFFIX,claude.ai,{{{Proxy}}}
DOMAIN-SUFFIX,anthropic.com,{{{Proxy}}}

# Gemini
DOMAIN-SUFFIX,gemini.google.com,{{{Proxy}}}
DOMAIN-SUFFIX,google.com,{{{Proxy}}}

# ChatGPT
DOMAIN-SUFFIX,chatgpt.com,{{{Proxy}}}
DOMAIN-SUFFIX,openai.com,{{{Proxy}}}
DOMAIN-SUFFIX,oaistatic.com,{{{Proxy}}}
DOMAIN-SUFFIX,oaiusercontent.com,{{{Proxy}}}

# ==================================
# --- [独立自定义策略组网站] ---
# ==================================

# 爱啪思道 (精确匹配)
DOMAIN,app.localhost.qaq.wiki,{{{Policy_Apasidao}}}

# GCP (IP 匹配)
IP-CIDR,35.212.188.11/32,{{{Policy_GCP}}},no-resolve

# IP-API (通配后缀匹配)
DOMAIN-SUFFIX,ip-api.com,{{{Policy_IPAPI}}}

# Browserleaks (后缀匹配)
DOMAIN-SUFFIX,browserleaks.com,{{{Policy_Browserleaks}}}

# GitBlur (后缀匹配)
DOMAIN-SUFFIX,gitblur.com,{{{Policy_GitBlur}}}

# Greasy Fork (后缀匹配)
DOMAIN-SUFFIX,greasyfork.org,{{{Policy_GreasyFork}}}
