name: "PingMe Auto CheckIn"
description: "获取Cookie + 自动化签到 + 视频奖励，支持多账号及 UI 模式切换。"
author: "Egern Config"
icon: "message.badge.filled"

# UI 交互模式设置
env_schema:
  CAPTURE_ENABLED:
    name: "账号抓取 - 启用"
    description: "关闭后抓包脚本不再处理任何请求"
    options:
      - "true"
      - "false"
    default_value: "true"

  TASK_ENABLED:
    name: "签到任务 - 总开关"
    description: "关闭后定时任务不执行任何操作"
    options:
      - "true"
      - "false"
    default_value: "true"

  ENABLE_CHECKIN:
    name: "签到任务 - 执行签到"
    description: "是否执行每日签到"
    options:
      - "true"
      - "false"
    default_value: "true"

  ENABLE_VIDEO:
    name: "签到任务 - 执行视频奖励"
    description: "是否领取视频奖励金币"
    options:
      - "true"
      - "false"
    default_value: "true"

  MAX_VIDEO:
    name: "签到任务 - 最大视频次数"
    description: "每账号每次最多领取视频奖励次数 (1-10)"
    default_value: "5"

mitm:
  hostnames:
    - "api.pingmeapp.net"

http_captures:
  - "api.pingmeapp.net"

scriptings:
  - http_request:
      name: "PingMe 账号抓取"
      match: "^https://api\\.pingmeapp\\.net/app/queryBalanceAndBonus"
      script_url: "https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js"
      timeout: 60

  - schedule:
      name: "PingMe 签到任务"
      # 保持你原来的 Cron 时间: 10:30, 18:30, 22:30
      cron: "30 10,18,22 * * *"
      script_url: "https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js"
      timeout: 120
