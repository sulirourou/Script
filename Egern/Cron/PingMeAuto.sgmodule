name: PingMe Auto1
description: 只控制获取Cookie（默认已禁止，推荐保持关闭）

compat_arguments:
  获取Cookie: 'false'      # 默认false = 禁止获取Cookie

compat_arguments_desc: "- 获取Cookie 参数：[true, false]\n\ntrue = 启用获取Cookie（需要重新抓取时打开）\nfalse = 禁止获取Cookie（已获取成功后推荐保持false）"

scriptings:
  - http_request:
      name: PingMe 获取cookie
      match: ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js
      timeout: 60

  - schedule:
      name: PingMe 自动化签到+视频奖励
      cron: "30 10,18,22 * * *"
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js
      timeout: 120

mitm:
  hostnames:
    - api.pingmeapp.net