name: PingMe Auto31
description: 只控制获取Cookie（已获取后建议关闭）

compat_arguments:
  获取Cookie: 'false'      # 面板默认显示 false

compat_arguments_desc: |-
  - 获取Cookie 参数：[true, false]

  true = 启用获取Cookie（需要重新抓取时打开）
  false = 禁用获取Cookie（推荐已获取成功后设为false）

scriptings:
  - http_request:
      name: PingMe 获取cookie
      match: ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js
      timeout: 60
      enable: {获取Cookie}   # Egern 会在底层把面板里的 true/false 文本替换到这里

  - schedule:
      name: PingMe 自动化签到+视频奖励
      cron: "30 10,18,22 * * *"
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js
      timeout: 120

mitm:
  hostnames:
    - api.pingmeapp.net
