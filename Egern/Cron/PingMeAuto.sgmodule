name: PingMe Auto
description: Cookie获取+自动化签到+视频奖励

compat_arguments:
  获取Cookie: 'false'      # true = 启用获取Cookie，false = 禁用获取Cookie

compat_arguments_desc: "- 获取Cookie 参数：[true, false]\n\ntrue = 启用获取Cookie（需要重新抓取时打开）\nfalse = 禁用获取Cookie（推荐已获取成功后设为false）"

scriptings:
  - http_request:
      name: PingMe 获取cookie
      match: ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js
      timeout: 60
      # 通过 compat_arguments 控制（Egern 会自动处理）

  - schedule:
      name: PingMe 自动化签到+视频奖励
      cron: "30 10,18,22 * * *"
      script_url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js
      timeout: 60

mitm:
  hostnames:
    - api.pingmeapp.net